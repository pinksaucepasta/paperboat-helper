{
  "version": "1.0.0",
  "algorithm": "EdDSA",
  "key_type": "Ed25519",
  "clock_skew_seconds": 60,
  "classes": [
    {
      "id": "cli_session",
      "audience": "paperboat-server",
      "scopes": [
        "account:read",
        "clients:revoke",
        "projects:read",
        "projects:connect",
        "session:refresh"
      ],
      "max_lifetime_seconds": 900,
      "single_use": false,
      "storage": "os_credential_store",
      "binding": [
        "user",
        "client_session",
        "issuer"
      ]
    },
    {
      "id": "helper_enrollment",
      "audience": "paperboat-enrollment",
      "scopes": [
        "helper:enroll"
      ],
      "max_lifetime_seconds": 600,
      "single_use": true,
      "storage": "bootstrap_memory_only",
      "binding": [
        "environment",
        "enrollment"
      ]
    },
    {
      "id": "helper_identity",
      "audience": "paperboat-control",
      "scopes": [
        "helper:connect",
        "helper:renew"
      ],
      "max_lifetime_seconds": 3600,
      "single_use": false,
      "storage": "helper_private_store",
      "binding": [
        "environment",
        "machine",
        "helper",
        "key_thumbprint"
      ]
    },
    {
      "id": "machine_control",
      "audience": "paperboat-control",
      "scopes": [
        "machine:connect",
        "machine:renew"
      ],
      "max_lifetime_seconds": 3600,
      "single_use": false,
      "storage": "machine_private_store",
      "binding": [
        "user",
        "machine",
        "environment",
        "key_thumbprint",
        "installation_generation"
      ]
    },
    {
      "id": "connector_admission",
      "audience": "paperboat-edge",
      "scopes": [
        "connector:admit"
      ],
      "max_lifetime_seconds": 300,
      "single_use": true,
      "storage": "connector_memory_only",
      "binding": [
        "environment",
        "machine",
        "installation_generation",
        "connector_id",
        "connector_generation",
        "edge_pool",
        "edge_node",
        "file_transfer_policy"
      ]
    },
    {
      "id": "terminal_operation",
      "audience": "paperboat-machine",
      "scopes": [
        "terminal:operate"
      ],
      "max_lifetime_seconds": 300,
      "single_use": false,
      "storage": "client_memory_only",
      "binding": [
        "user",
        "machine",
        "client_session",
        "environment",
        "session"
      ]
    },
    {
      "id": "file_transfer",
      "audience": "paperboat-machine",
      "scopes": [
        "file:transfer"
      ],
      "max_lifetime_seconds": 300,
      "single_use": false,
      "storage": "client_memory_only",
      "binding": [
        "user",
        "machine",
        "client_session",
        "environment",
        "session"
      ]
    },
    {
      "id": "preview_launch",
      "audience": "paperboat-machine",
      "scopes": [
        "preview:launch"
      ],
      "max_lifetime_seconds": 300,
      "single_use": false,
      "storage": "client_memory_only",
      "binding": [
        "user",
        "machine",
        "client_session",
        "environment"
      ]
    },
    {
      "id": "preview_registration",
      "audience": "paperboat-control",
      "scopes": [
        "preview:register"
      ],
      "max_lifetime_seconds": 300,
      "single_use": false,
      "storage": "helper_memory_only",
      "binding": [
        "environment",
        "machine",
        "installation_generation"
      ]
    },
    {
      "id": "config_sync",
      "audience": "paperboat-machine",
      "scopes": [
        "config:pull",
        "config:apply",
        "config:report"
      ],
      "max_lifetime_seconds": 300,
      "single_use": false,
      "storage": "machine_memory_only",
      "binding": [
        "machine",
        "environment",
        "installation_generation",
        "assignment",
        "warning_revision"
      ]
    },
    {
      "id": "signed_update",
      "audience": "paperboat-machine",
      "scopes": [
        "update:read"
      ],
      "max_lifetime_seconds": 300,
      "single_use": false,
      "storage": "helper_memory_only",
      "binding": [
        "environment",
        "helper",
        "release_channel"
      ]
    },
    {
      "id": "edge_control",
      "audience": "paperboat-edge-control",
      "scopes": [
        "route:attach",
        "connector:replace"
      ],
      "max_lifetime_seconds": 300,
      "single_use": true,
      "storage": "service_memory_only",
      "binding": [
        "environment",
        "connector_generation",
        "edge_node"
      ]
    },
    {
      "id": "usage_report",
      "audience": "paperboat-control",
      "scopes": [
        "usage:report"
      ],
      "max_lifetime_seconds": 300,
      "single_use": false,
      "storage": "edge_private_store",
      "binding": [
        "edge_node",
        "counter_epoch"
      ]
    }
  ]
}
