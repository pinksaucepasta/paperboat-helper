{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paperboat://contracts/1.0.0/credentials/claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["iss", "aud", "sub", "jti", "iat", "exp", "scope", "credential_class"],
  "properties": {
    "iss": {"type": "string", "format": "uri", "maxLength": 512},
    "aud": {"type": "string", "minLength": 1, "maxLength": 128},
    "sub": {"type": "string", "minLength": 1, "maxLength": 128},
    "jti": {"type": "string", "minLength": 8, "maxLength": 128},
    "iat": {"type": "integer", "minimum": 0},
    "exp": {"type": "integer", "minimum": 1},
    "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-z0-9_-]*$"}},
    "credential_class": {"type": "string", "minLength": 1, "maxLength": 64},
    "environment_id": {"type": "string", "maxLength": 128},
    "user_id": {"type": "string", "maxLength": 128},
    "cli_client_session_id": {"type": "string", "maxLength": 128},
    "helper_id": {"type": "string", "maxLength": 128},
    "machine_id": {"type": "string", "maxLength": 128},
    "installation_generation": {"type": "integer", "minimum": 1},
    "session_id": {"type": "string", "maxLength": 128},
    "assignment_id": {"type": "string", "maxLength": 128},
    "warning_revision": {"type": "string", "maxLength": 128},
    "connector_id": {"type": "string", "maxLength": 128},
    "connector_generation": {"type": "integer", "minimum": 1},
    "edge_pool": {"type": "string", "maxLength": 128},
    "edge_node_id": {"type": "string", "maxLength": 128},
    "file_transfer_policy": {"$ref": "#/$defs/file_transfer_policy"},
    "counter_epoch": {"type": "string", "maxLength": 128},
    "cnf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jkt"],
      "properties": {"jkt": {"type": "string", "minLength": 43, "maxLength": 128}}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"credential_class": {"const": "connector_admission"}}, "required": ["credential_class"]},
      "then": {"required": ["machine_id", "installation_generation", "connector_id", "connector_generation", "edge_pool", "edge_node_id", "file_transfer_policy"]}
    },
    {
      "if": {"properties": {"credential_class": {"const": "preview_launch"}}, "required": ["credential_class"]},
      "then": {"required": ["environment_id", "machine_id", "user_id", "cli_client_session_id"]}
    }
  ],
  "$defs": {
    "file_transfer_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "max_file_bytes", "max_batch_files", "max_batch_bytes", "max_concurrent_transfers", "retention_seconds", "delivery_timeout_seconds", "max_pending_spool_bytes"],
      "properties": {
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "max_file_bytes": {"type": "integer", "minimum": 1},
        "max_batch_files": {"type": "integer", "minimum": 1},
        "max_batch_bytes": {"type": "integer", "minimum": 1},
        "max_concurrent_transfers": {"type": "integer", "minimum": 1},
        "retention_seconds": {"type": "integer", "minimum": 1},
        "delivery_timeout_seconds": {"type": "integer", "minimum": 1},
        "max_pending_spool_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
